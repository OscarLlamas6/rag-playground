# Copia este archivo a `.env` (en esta carpeta o dentro de cada proyecto) y completa lo que uses.
# El .env NUNCA se sube a Git (ya está en .gitignore).

# ── Para usar OpenAI en TODO (respuestas y embeddings) ───────────────
#    OPENAI_API_KEY=sk-...
#    LLM_PROVIDER=openai                       (modelo por defecto: gpt-6-luna; cámbialo con LLM_MODEL)
#    EMBEDDINGS_PROVIDER=openai
#    EMBEDDINGS_MODEL=text-embedding-3-small   (1536 dimensiones; con EMBEDDINGS_DIMENSIONS=768 se acorta a 768)
#    ¡Cambia también EMBEDDINGS_MODEL! Si queda el de LM Studio (nomic), OpenAI responde "model not found".

# ── Modelo que redacta las respuestas ────────────────────────────────
LLM_PROVIDER=anthropic            # anthropic | openai | local | fake
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_MODEL=                      # modelo que redacta las respuestas con anthropic u openai. Si lo dejas vacío:
#                                 #   anthropic → claude-haiku-5-5 · openai → gpt-6-luna
#                                 # Con LLM_PROVIDER=local NO se usa: manda LOCAL_LLM_MODEL (abajo). Así puedes cambiar de
#                                 # proveedor tocando solo LLM_PROVIDER.
#                                 # Ejemplos: LLM_MODEL=gpt-6-sol · LLM_MODEL=claude-sonnet-5-5
LOCAL_LLM_URL=http://localhost:1234/v1     # LM Studio u otro servidor compatible con OpenAI (en Docker, `localhost` se traduce solo)
LOCAL_LLM_MODEL=llama-3.2-3b-instruct

# ── Modelo de embeddings (convierte texto en vectores) ───────────────
EMBEDDINGS_PROVIDER=local         # local | openai | fake
EMBEDDINGS_MODEL=text-embedding-nomic-embed-text-v2-moe
# EMBEDDINGS_DIMENSIONS=768       # solo OpenAI

# ── rag-simple: Neon (PostgreSQL + pgvector) ─────────────────────────
STORE=neon                        # neon | memory
NEON_DATABASE_URL=                # postgresql://usuario:clave@host/base?sslmode=require
# NEON_TABLE=rag_simple_chunks

# ── rag-intermedio: Pinecone ─────────────────────────────────────────
PINECONE_API_KEY=
# PINECONE_INDEX=rag-playground   # dimensión 768 si usas nomic; coseno
# PINECONE_NAMESPACE=rag-intermedio
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ── rag-intermedio: PDF (Docling, con OCR), audio y video (faster-whisper) ──
# Requiere el grupo opcional `media`:  cd rag-intermedio && task install:media
# Todas son opcionales; los valores de abajo son los de por defecto.
# Carpeta con tus audios y videos. Debe existir (mkdir -p backend/data/media). No va a git.
# MEDIA_DIR=backend/data/media
# Dónde se guardan las transcripciones y conversiones de Docling. Con caché, volver a ingestar es instantáneo.
# MEDIA_CACHE_DIR=backend/.cache/media
# Máximo de páginas que se leen por PDF (0 = sin tope). En CPU, un PDF de 142 páginas tarda mucho.
# DOCLING_MAX_PAGES=30
# Cuándo usar OCR en los PDF: auto = solo si faltan textos, off = nunca, force = siempre.
# DOCLING_OCR=auto
# Una página con menos caracteres que esto cuenta como "sin texto" y, en modo auto, se reintenta con OCR.
# DOCLING_MIN_CHARS=40
# Tokenizer de Hugging Face que usa docling_hybrid para contar tokens. Vacío = el del modelo de embeddings
# (nomic v2) o all-MiniLM-L6-v2.
# DOCLING_TOKENIZER=
# Modelo de Whisper para transcribir. base = más rápido y menos preciso; small = más preciso (≈ 460 MB).
# WHISPER_MODEL=small
# Idioma del audio (por ejemplo es, en). Vacío = lo detecta solo.
# WHISPER_LANGUAGE=
# Vocabulario que orienta a Whisper (nombres propios, siglas, términos técnicos). Reduce errores de transcripción.
# WHISPER_PROMPT=
# Duración en segundos de cada fragmento de la transcripción (cada ventana es un chunk).
# MEDIA_WINDOW_SECONDS=50
# Segundos que se repiten entre ventanas contiguas para no cortar una idea a la mitad.
# MEDIA_OVERLAP_SECONDS=8
# EXPERIMENTAL: describe fotogramas del video con un modelo con visión y los agrega al texto.
# FRAME_CAPTIONS=false
# Cada cuántos segundos se toma un fotograma (solo si FRAME_CAPTIONS=true).
# FRAME_INTERVAL_SECONDS=60
# Proveedor del modelo con visión: local (LM Studio) | openai | anthropic.
# VISION_PROVIDER=local
# Modelo con visión. Vacío = el predeterminado del proveedor (o LOCAL_LLM_MODEL si es local).
# VISION_MODEL=
# Web: segundos de espera del proxy. La primera ingesta con medios puede tardar minutos.
# PROXY_TIMEOUT_SECONDS=900

# ── rag-avanzado: PostgreSQL + pgvector (Docker) ─────────────────────
AVANZADO_STORE=postgres            # postgres | memory   (NO usa STORE: ese es de rag-simple y rag-intermedio)
# DATABASE_URL=postgresql://rag:rag@127.0.0.1:5434/rag   # solo si corres el backend fuera de Docker (task db:up); en Docker la fija el compose
# POSTGRES_PASSWORD=rag            # contraseña de desarrollo del servicio db (la base no sale de tu equipo)
